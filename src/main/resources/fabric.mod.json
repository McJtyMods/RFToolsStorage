{
  "schemaVersion": 1,
  "id": "rftoolsstorage",
  "version": "${version}",
  "name": "RFToolsStorage",
  "description": "Modular Storage, Storage Scanner, and Crafting Manager",
  "authors": [
    "McJty"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mcjty.rftoolsstorage.RFToolsStorage"
    ],
    "client": [
      "mcjty.rftoolsstorage.setup.ClientSetup"
    ],
    "fabric-datagen": [
      "mcjty.rftoolsstorage.datagen.FabricDataGen"
    ],
    "xnet": [
      "mcjty.rftoolsstorage.compat.xnet.XNetSupport"
    ],
    "rftoolsutility": [
      "mcjty.rftoolsstorage.compat.rftoolsutility.RFToolsSupport::register"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.164.0+26.3",
    "forgeconfigapiport": ">=26.3.1",
    "mcjtylib": ">=26.3-11.0.4-fabric",
    "rftoolsbase": ">=26.3-9.0.0-fabric"
  },
  "suggests": {
    "theoneprobe": "*",
    "jei": "*",
    "xnet": "*",
    "rftoolsutility": "*"
  },
  "accessWidener": "rftoolsstorage.accesswidener"
}
